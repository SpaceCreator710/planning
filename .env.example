# Public client configuration only. Never put service-role or payment secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-created checkout pages. Mobile store subscriptions still use
# App Store / Google Play billing in production.
EXPO_PUBLIC_PAYPAL_CHECKOUT_URL=
EXPO_PUBLIC_CARD_CHECKOUT_URL=
EXPO_PUBLIC_RU_CHECKOUT_URL=
EXPO_PUBLIC_DEMO_BILLING=true

# Groq structured-output model. This key is SERVER-ONLY.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Optional server abuse controls. Netlify automatically provides URL for the
# deployed site; add comma-separated extra origins only when needed.
AI_ALLOWED_ORIGINS=
AI_REQUESTS_PER_MINUTE=24

# Web uses /api/ai automatically. Native release builds point to the deployed
# server function, for example https://your-site.netlify.app/api/ai.
EXPO_PUBLIC_AI_ENDPOINT=
