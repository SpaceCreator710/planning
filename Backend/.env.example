# Configure these in Netlify / server environment. Never ship them in the iOS bundle.
# Preferred provider:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback provider:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
AI_REQUESTS_PER_MINUTE=24
AI_ALLOWED_ORIGINS=
AI_PROVIDER_TIMEOUT_MS=28000
